# Git LFS — large binary media for the /vehicles Clover experience.
#
# The vehicle page ships ~99 MB of media (build-sequence frames, gallery videos,
# 3D models, component photos). Storing these through Git LFS keeps the main repo
# lean: git tracks small text pointers while the binaries live in LFS storage.
#
# Scoped to public/vehicle/ so the rest of the repo's assets (favicon, small UI
# images) stay as normal git objects.
public/vehicle/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
public/vehicle/**/*.glb filter=lfs diff=lfs merge=lfs -text
public/vehicle/**/*.png filter=lfs diff=lfs merge=lfs -text
public/vehicle/**/*.jpg filter=lfs diff=lfs merge=lfs -text
